#!/bin/sh
# shellcheck shell=busybox
# shellcheck disable=SC1091
. /usr/share/libubox/jshn.sh
. /etc/mihomo/core.sh

reply() {
	json_init
	json_add_boolean ok "$1"
	json_add_string code "$2"
	json_add_string details "${3:-}"
	json_dump
}

case "$1" in
	list)
		printf '%s\n' '{"status":{},"read":{},"logs":{},"cache":{},"check":{"content":"String"},"save":{"content":"String","revision":"String"},"action":{"name":"String","revision":"String"},"autostart":{"enabled":true},"upload":{"content":"String"},"download":{"url":"String"},"update_core":{"url":"String"},"save_url":{"key":"String","url":"String"}}'
		exit 0;;
	call) ;;
	*) exit 1;;
esac

prepare || { reply 0 'directories_failed' "$DETAILS"; exit 0; }
case "$2" in
	upload)
		kind='' content=''
		payload=$(head -c 2097152)
		json_load "$payload" 2>/dev/null || { reply 0 request_invalid; exit 0; }
		json_get_type kind content
		[ "$kind" = string ] || { reply 0 content_invalid; exit 0; }
		json_get_var content content
		lock || { reply 0 operation_busy; exit 0; }
		trap 'unlock' EXIT
		settings || { reply 0 "$ERROR"; exit 0; }
		save_config "$content" "" || { reply 0 "$ERROR"; exit 0; }
		json_init
		json_add_boolean ok 1
		json_add_string code config_saved
		json_dump
		;;
	download)
		url=''
		payload=$(head -c 1024)
		json_load "$payload" 2>/dev/null || { reply 0 request_invalid; exit 0; }
		json_get_var url url
		[ -n "$url" ] || { reply 0 'url_invalid'; exit 0; }
		content=$(wget -q -O - "$url") || { reply 0 'download_failed'; exit 0; }
		lock || { reply 0 operation_busy; exit 0; }
		trap 'unlock' EXIT
		settings || { reply 0 "$ERROR"; exit 0; }
		save_config "$content" "" || { reply 0 "$ERROR"; exit 0; }
		json_init
		json_add_boolean ok 1
		json_add_string code config_saved
		json_add_string content "$content"
		json_dump
		;;
	update_core)
		url=''
		payload=$(head -c 2048)
		json_load "$payload" 2>/dev/null || { reply 0 request_invalid; exit 0; }
		json_get_var url url
		[ -n "$url" ] || { reply 0 'url_invalid'; exit 0; }
		lock || { reply 0 operation_busy; exit 0; }
		# 下载大体积核心耗时较长，交由后台 worker 处理，避免 XHR/ubus 超时；
		# worker 退出时会自行释放锁，这里不能 trap unlock。
		job queued operation_queued
		# 交接给后台 worker：清掉本进程 pid，锁在 worker 写入自身 pid 前由 start 宽限期守护
		rm -f "$RUN/lock/pid"
		/usr/libexec/mihomo-panel-worker update_core "$url" </dev/null >/dev/null 2>&1 &
		reply 1 operation_queued
		exit 0;;
	save_url)
		key='' url=''
		payload=$(head -c 4096)
		json_load "$payload" 2>/dev/null || { reply 0 request_invalid; exit 0; }
		json_get_var key key
		json_get_var url url
		# 仅允许写入这两个已知字段，且服务端可靠创建 UCI 文件/节，规避前端首次运行时节不存在导致的保存失败。
		case "$key" in core_url|download_url) ;; *) reply 0 request_invalid; exit 0;; esac
		ensure_uci || { reply 0 config_save_failed; exit 0; }
		if uci set "mihomo.main.$key=$url" && uci commit mihomo; then
			reply 1 config_saved
		else
			reply 0 config_save_failed
		fi
		exit 0;;
	cache)
		CACHE=''
		cache_ok=1
		ERROR=''
		cache_settings || cache_ok=0
		pid=$(running_pid)
		json_init
		json_add_boolean ok "$cache_ok"
		json_add_string code "$ERROR"
		json_add_string path "$CACHE"
		json_add_string workdir "$WORKDIR"
		json_add_string token "${CACHE_TOKEN:-}"
		json_add_boolean running "$([ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && echo 1 || echo 0)"
		json_dump;;
	status)
		config_error=''
		settings || config_error="$ERROR"
		pid=$(running_pid)
		boot=0
		"$INIT" enabled >/dev/null 2>&1 && [ "$(uci -q get mihomo.main.enabled)" = 1 ] && boot=1
		busy=0
		lock_busy && busy=1
		job_data=$(cat "$RUN/job.json" 2>/dev/null)
		json_init
		json_add_boolean ok 1
		json_add_string error_code "$config_error"
		json_add_string version "$(core_version "$BIN")"
		json_add_string config "$CONFIG"
		json_add_string revision "$([ -z "$config_error" ] && config_revision)"
		json_add_string pid "$pid"
		json_add_boolean running "$([ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && echo 1 || echo 0)"
		json_add_boolean autostart "$boot"
		json_add_boolean busy "$busy"
		json_add_string job "$job_data"
		json_dump;;
	read)
		settings || { reply 0 "$ERROR"; exit 0; }
		if [ -f "$CONFIG" ] && [ "$(wc -c < "$CONFIG")" -gt "$MAX_SIZE" ]; then
			reply 0 config_too_large; exit 0
		fi
		revision=$(config_revision)
		content=$(cat "$CONFIG" 2>/dev/null; printf '.')
		content=${content%.}
		[ "$revision" = "$(config_revision)" ] || { reply 0 config_changed; exit 0; }
		json_init
		json_add_boolean ok 1
		json_add_string content "$content"
		json_add_string revision "$revision"
		json_dump;;
	logs)
		load_settings
		mode=system
		if [ -f "$CONFIG" ] && [ ! -L "$CONFIG" ]; then
			level=$(sed -n 's/^[[:space:]]*log-level:[[:space:]]*//p' "$CONFIG" 2>/dev/null | head -n 1 | tr -d "\"' " | tr 'A-Z' 'a-z')
			[ "$level" != silent ] || mode=disabled
		fi
		raw=$(run_timeout 3 logread -e 'mihomo' 2>/dev/null) || {
			reply 0 'logs_failed'; exit 0;
		}
		lines=$(printf '%s\n' "$raw" | grep -E 'mihomo(\[[0-9]+\])?:' | tail -n 300 | tail -c 32768 | sed 's/.*mihomo[^:]*: //; s/^[+-][0-9]\{4\} //; 1!G; h; $!d')
		json_init
		json_add_boolean ok 1
		json_add_string mode "$mode"
		json_add_string content "$lines"
		json_dump;;
	save|check)
		kind='' content='' revision=''
		payload=$(head -c 2097152)
		json_load "$payload" 2>/dev/null || { reply 0 request_invalid; exit 0; }
		json_get_type kind content
		[ "$kind" = string ] || { reply 0 content_invalid; exit 0; }
		json_get_var content content
		json_get_var revision revision
		[ "$(printf '%s' "$content" | wc -c)" -le "$MAX_SIZE" ] || { reply 0 config_too_large; exit 0; }
		lock || { reply 0 operation_busy; exit 0; }
		trap 'unlock' EXIT
		settings || { reply 0 "$ERROR"; exit 0; }
		if [ "$2" = check ]; then
			trap 'rm -f "$RUN/validation.yaml"; unlock' EXIT
			printf '%s' "$content" > "$RUN/validation.yaml" || { reply 0 check_prepare_failed; exit 0; }
			job queued operation_queued
			rm -f "$RUN/lock/pid"
			/usr/libexec/mihomo-panel-worker validate </dev/null >/dev/null 2>&1 &
			trap - EXIT
			reply 1 operation_queued
			exit 0
		fi
		save_config "$content" "$revision" || { reply 0 "$ERROR"; exit 0; }
		json_init
		json_add_boolean ok 1
		json_add_string code config_saved
		json_add_string revision "$(config_revision)"
		json_dump;;
	action)
		name='' revision=''
		payload=$(head -c 1024)
		json_load "$payload" 2>/dev/null || { reply 0 'request_invalid'; exit 0; }
		json_get_var name name
		json_get_var revision revision
		case "$name" in apply|start|stop|restart|cache_reset|cache_reset_start) ;; *) reply 0 'action_unknown'; exit 0;; esac
		lock || { reply 0 'operation_busy'; exit 0; }
		action_settings "$name" || { unlock; reply 0 "$ERROR"; exit 0; }
		case "$name" in apply)
			actual=$(config_revision)
			if [ -z "$revision" ] || [ "$revision" != "$actual" ]; then
				unlock; reply 0 config_changed; exit 0
			fi;;
		cache_reset|cache_reset_start)
			cache_settings || { unlock; reply 0 "$ERROR"; exit 0; }
			if [ -z "$revision" ] || [ "$revision" != "$CACHE_TOKEN" ]; then
				unlock; reply 0 cache_changed; exit 0
			fi;;
		esac
		job queued operation_queued
		rm -f "$RUN/lock/pid"
		/usr/libexec/mihomo-panel-worker "$name" "$revision" </dev/null >/dev/null 2>&1 &
		reply 1 'operation_queued';;
	autostart)
		kind='' enabled=''
		payload=$(head -c 1024)
		json_load "$payload" 2>/dev/null || { reply 0 'request_invalid'; exit 0; }
		json_get_type kind enabled
		json_get_var enabled enabled
		[ "$kind" = boolean ] || { reply 0 'enabled_invalid'; exit 0; }
		lock || { reply 0 'operation_busy'; exit 0; }
		trap 'unlock' EXIT
		ensure_uci || { reply 0 'autostart_failed'; exit 0; }
		init_action=disable
		if [ "$enabled" = 1 ]; then
			if ! { uci set mihomo.main.enabled=1 && uci commit mihomo; }; then
				reply 0 'autostart_failed'; exit 0
			fi
			init_action=enable
		fi
		if "$INIT" "$init_action" > "$RUN/service.log" 2>&1; then
			reply 1 'autostart_updated'
		else
			reply 0 'autostart_failed'
		fi;;
	*) reply 0 'method_unknown';;
esac
