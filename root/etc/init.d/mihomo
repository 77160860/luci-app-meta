#!/bin/sh /etc/rc.common
# procd service for mihomo (Clash.Meta), shipped by luci-app-meta so the panel
# can control a binary-only core package (e.g. mihomo-meta, which PROVIDES mihomo
# but installs no init script). Service name "mihomo" matches the panel backend.

USE_PROCD=1
START=99
STOP=10

PROG="/usr/bin/mihomo"

uci_get() {
	local val
	val="$(uci -q get "mihomo.main.$1")"
	[ -n "$val" ] && echo "$val" || echo "$2"
}

start_service() {
	[ "$(uci_get enabled 0)" = 1 ] || return 0

	local conffile workdir
	conffile="$(uci_get conffile /etc/mihomo/config.yaml)"
	workdir="$(uci_get workdir /etc/mihomo)"

	[ -x "$PROG" ] || return 1
	mkdir -p "$workdir"

	procd_open_instance mihomo
	procd_set_param command "$PROG" -d "$workdir" -f "$conffile"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="1048576 1048576"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "mihomo"
}
